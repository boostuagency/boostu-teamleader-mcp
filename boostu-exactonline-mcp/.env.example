# BoostU Exact Online MCP — kopieer naar .env en vul in (zie docs/AUTHENTICATION.md)

# Verplicht: OAuth2-credentials uit je app in het Exact App Center
EXACT_CLIENT_ID=
EXACT_CLIENT_SECRET=
EXACT_REFRESH_TOKEN=

# Regio van de Exact Online-omgeving: be, nl, de, fr, uk, es, com
# (of een volledige base-URL). Standaard: be
EXACT_REGION=be

# Sterk aanbevolen: bestandspad waar de roterende refresh token wordt bewaard.
# Exact roteert de refresh token bij ELKE vernieuwing en maakt de vorige direct
# ongeldig; zonder dit bestand moet je na elke herstart opnieuw autoriseren.
EXACT_TOKEN_STORE=.exact-token

# Optioneel: pin alle calls op één administratie. Leeg = de huidige divisie van
# de geautoriseerde gebruiker. Tools accepteren daarnaast een 'division'-argument.
# EXACT_DIVISION=123456

# Optioneel: alleen lezen. Geen create-, update- of delete-tools worden geladen.
# Aanrader wanneer een klant enkel wil bevragen.
# EXACT_READ_ONLY=true

# Optioneel: beperk welke toolgroepen geladen worden (komma-gescheiden; leeg = alle).
# Groepen: system,relations,sales,purchase,financial,reports,banking,items,vat,documents
# EXACT_TOOLS=system,reports,relations,sales

# Alleen voor de hulpscripts: moet exact overeenkomen met de Redirect URI in het App Center
REDIRECT_URI=http://localhost:8000/oauth/callback
